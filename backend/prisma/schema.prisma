// Prisma 7 Schema Configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  eventType  String   @map("event_type")
  payload    Json
  timestamp  DateTime
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([timestamp])
  @@index([userId])

  @@map("events")
}